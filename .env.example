# Database Configuration
# Database URL for Prisma. For local development, use a connection string like:
# For SQLite: "file:./dev.db"
# For PostgreSQL: "postgresql://username:password@localhost:5432/dbname"
# For Prisma Accelerate: "prisma+postgres://accelerate.prisma-data.net/?api_key=your_api_key"
DATABASE_URL="your_database_url_here"

# Data source for public content (blog posts / projects)
# - "local": render from MDX files and data/projects.ts (live source edits in dev)
# - "db": render from the database (DB wins over source files)
# Defaults to "db" in production and "local" in development.
DATA_SOURCE="local"

# Admin Configuration
# Comma-separated list of GitHub logins allowed to access the admin area
AUTH_ADMIN_GITHUB_LOGINS="your_github_login"

# GitHub OAuth Configuration
# Create OAuth apps at https://github.com/settings/developers
# One app for production (callback https://danadavis.dev/api/auth/github/callback)
# and one for local dev (callback http://localhost:3434/api/auth/github/callback)
GITHUB_OAUTH_CLIENT_ID="your_github_oauth_client_id"
GITHUB_OAUTH_CLIENT_SECRET="your_github_oauth_client_secret"
# Secret used to sign auth cookies. Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET="your_session_secret"

# Giscus Comments Configuration
# Configure at https://giscus.app and copy the generated values
# Requires GitHub Discussions enabled on the repo
PUBLIC_GISCUS_REPO="your_github_username/your_repo_name"
PUBLIC_GISCUS_REPOSITORY_ID="your_giscus_repository_id"
PUBLIC_GISCUS_CATEGORY="announcements"
PUBLIC_GISCUS_CATEGORY_ID="your_giscus_category_id"

SITE_URL="http://localhost:3000"

# Disqus Configuration
# Get your shortname from https://disqus.com/admin/
DISQUS_SHORTNAME="your_disqus_shortname"

# GitHub API Token
# Create a personal access token at https://github.com/settings/tokens
# Required scopes: repo, read:user
GITHUB_API_TOKEN="your_github_api_token"

# Spotify API Credentials
# Get these from Spotify Developer Dashboard at https://developer.spotify.com/dashboard
# 1. Create an app in your dashboard
# 2. Copy the Client ID and Client Secret
# These are used to authenticate with Spotify Web API using OAuth2
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"
# Optional: Add a refresh token to enable user-specific data access (currently playing, recently played)
SPOTIFY_REFRESH_TOKEN="your_spotify_refresh_token"

# Umami Analytics
# Get your Umami ID from your Umami dashboard
NEXT_UMAMI_ID="your_umami_id"

# OpenAI API Key
# Get your API key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY="your_openai_api_key"